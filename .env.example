# TaskBox local configuration (safe defaults for the SQLite lab)
APP_ENV=development
DATABASE_URL=sqlite:///./taskbox.db
JWT_SECRET=change-me-in-development
JWT_ALGORITHM=HS256
JWT_EXPIRES_MINUTES=60
WEBHOOK_SECRET=change-me-in-development
LOG_LEVEL=INFO

# PostgreSQL lab (compose.yaml)
POSTGRES_DB=taskbox
POSTGRES_USER=taskbox
POSTGRES_PASSWORD=taskbox
POSTGRES_PORT=5432
